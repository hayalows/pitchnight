# Use a NEW Neon database, not English Chat Finder's database.
DATABASE_URL=
# A randomly generated secret, at least 32 characters. Never commit its value.
OFFSCRIPT_ANALYTICS_SESSION_SECRET=
# Set a strong organiser-only password (24+ characters).
OFFSCRIPT_ANALYTICS_ADMIN_PASSWORD=
# Required in production: random 32+ character Cloudflare-to-app bearer key. Same value in the Worker secret and Vercel.
OFFSCRIPT_ANALYTICS_EDGE_SECRET=
# Daily Vercel maintenance, separate 32+ character secret.
CRON_SECRET=
# Optional production URL; defaults to https://offscriptgh.com.
OFFSCRIPT_ANALYTICS_PUBLIC_ORIGIN=https://offscriptgh.com
